# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
BEPA_STOREFRONT_MODE=demo

# Supabase project (required for auth, checkout persistence, admin, and storage)
SUPABASE_PROJECT_REF=your-project-ref
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Preferred public key name. Keep the anon alias equal to the same value while
# older code or tools still reference NEXT_PUBLIC_SUPABASE_ANON_KEY.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-key

# Server-only key for privileged admin operations. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Database connections
# For local/dev it is fine to point both URLs at the direct database host.
# If you later add the transaction pooler URL, use that for DATABASE_URL
# and keep DIRECT_URL on the direct 5432 connection for migrations.
DATABASE_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres
DIRECT_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres
