{
  "name": "bepa",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:push": "node --import tsx scripts/db-push.ts",
    "db:pull": "prisma db pull",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "node --import tsx prisma/seed.ts",
    "db:seed:demo": "node --import tsx scripts/seed-demo.ts",
    "db:counts": "node --import tsx scripts/db-counts.ts",
    "security:check": "node --import tsx scripts/security-checks.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:integration": "node --import tsx --test tests/integration/*.test.ts",
    "db:constraints": "node --import tsx scripts/db-constraints.ts",
    "db:rls:bootstrap": "node --import tsx scripts/bootstrap-rls-test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run security:check && npm test && npm run build && npm run typecheck",
    "db:permissions": "node --import tsx scripts/check-db-permissions.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.95.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "lucide-react": "^0.563.0",
    "next": "16.4.6",
    "next-intl": "^4.16.2",
    "next-themes": "^0.4.6",
    "pg": "^8.18.0",
    "prisma": "7.10.1",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "shadcn": "^4.23.1",
    "tailwindcss": "^4",
    "tsx": "^4.22.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  },
  "engines": {
    "node": "22.x"
  },
  "overrides": {
    "@prisma/config": {
      "effect": "3.22.1"
    }
  }
}
